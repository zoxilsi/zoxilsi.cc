# Server-only Redis credentials for Vercel's /api/visitors function.
# The Vercel/Upstash integration can inject these automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Complete KV_REST_API_URL + KV_REST_API_TOKEN credentials are also supported.
# Keep the namespace unchanged to preserve the existing count across releases.
KEY_PREFIX=zoxilsi:portfolio:visitors
VISITOR_COUNT_MODE=unique

# The standalone local Node server uses its private JSON store instead.
# VISITOR_DATA_FILE=/path/to/persistent/visitors.json
